;
; PlanckVAD.inf: Planck Virtual Audio, a speaker endpoint whose audio comes
; back out of a microphone endpoint, both locked to 48 kHz 16-bit PCM.
;
; Copyright (c) 2026 Planck contributors. Derived from Virtual-Audio-Driver
; (MIT) and Microsoft's SysVAD sample (MS-PL); see LICENSE.
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,1.0.0.0
CatalogFile = PlanckVAD.cat
PnpLockdown = 1

[SourceDisksNames]
222 = %DiskName%,,,""

[SourceDisksFiles]
PlanckVAD.sys = 222

[Manufacturer]
%MfgName% = Planck,NT$ARCH$.10.0...19041

[Planck.NT$ARCH$.10.0...19041]
%PlanckVAD.DeviceDesc% = PlanckVAD_Device, ROOT\PlanckVirtualAudio

[DestinationDirs]
PlanckVAD_Device.CopyList = 13

;======================================================
; PlanckVAD_Device
;======================================================
[PlanckVAD_Device.CopyList]
PlanckVAD.sys

[PlanckVAD_Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,PlanckVAD.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%PlanckVAD.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%PlanckVAD.DeviceDesc%

;======================================================
; capture interfaces: microphone
;======================================================
[PlanckVAD.I.WaveMicArray1]
AddReg = PlanckVAD.I.WaveMicArray1.AddReg

[PlanckVAD.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PlanckVAD.Endpoint.szPname%

[PlanckVAD.I.TopologyMicArray1]
AddReg = PlanckVAD.I.TopologyMicArray1.AddReg

[PlanckVAD.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PlanckVAD.Endpoint.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; render interfaces: speaker
;======================================================
[PlanckVAD.I.WaveSpeaker]
AddReg = PlanckVAD.I.WaveSpeaker.AddReg

[PlanckVAD.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PlanckVAD.Endpoint.szPname%

[PlanckVAD.I.TopologySpeaker]
AddReg = PlanckVAD.I.TopologySpeaker.AddReg

[PlanckVAD.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PlanckVAD.Endpoint.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; PlanckVAD_Device
;======================================================
[PlanckVAD_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = PlanckVAD_Device.CopyList
AddReg    = PlanckVAD_Device.AddReg

[PlanckVAD_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%,       PlanckVAD.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%,       PlanckVAD.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%,       PlanckVAD.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologySpeaker%,   PlanckVAD.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%,   PlanckVAD.I.TopologySpeaker

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%,     PlanckVAD.I.WaveMicArray1
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%,     PlanckVAD.I.WaveMicArray1
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%,     PlanckVAD.I.WaveMicArray1
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, PlanckVAD.I.TopologyMicArray1
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, PlanckVAD.I.TopologyMicArray1

[PlanckVAD_Device.NT.Services]
AddService = PlanckVAD,0x00000002,PlanckVAD_Service_Inst

[PlanckVAD_Service_Inst]
DisplayName   = %PlanckVAD.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\PlanckVAD.sys

[PlanckVAD_Device.NT.HW]
AddReg = PlanckVAD_Device.HW.AddReg

[PlanckVAD_Device.HW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; WDF
;======================================================
[PlanckVAD_Device.NT.Wdf]
KmdfService = PlanckVAD, PlanckVAD_WdfSect

[PlanckVAD_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; COMMON
;======================================================
[Strings]
; Non-localizable

KSNAME_WaveSpeaker        = "WaveSpeaker"
KSNAME_TopologySpeaker    = "TopologySpeaker"
KSNAME_WaveMicArray1      = "WaveMicArray1"
KSNAME_TopologyMicArray1  = "TopologyMicArray1"

Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE  = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

; Localizable

ProviderName = "Planck"
MfgName      = "Planck"
DiskName     = "Planck Virtual Audio Driver Disk"

PlanckVAD.DeviceDesc      = "Planck Virtual Audio"
PlanckVAD.SvcDesc         = "Planck Virtual Audio"
PlanckVAD.Endpoint.szPname = "Planck Virtual Audio"
