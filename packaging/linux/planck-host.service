[Unit]
Description=Planck host: stream this desktop to Planck clients
Documentation=https://planck.gg
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/planck-host
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
