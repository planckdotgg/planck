    "$type": "dimension",
    "hair": {
      "$value": "1px"
    },
    "focus": {
      "$value": "2px"
    }
  },
  "elevation": {
    "$description": "Dark UI rises by lighter surface + 1 px border, not by shadow. One shadow, only for things that float over content.",
    "flat": {
      "$value": {
        "surface": "{role.ground}",
        "border": "none",
        "shadow": "none"
      }
    },
    "raised": {
      "$value": {
        "surface": "{role.surface}",
        "border": "{role.border}",
        "shadow": "none"
      }
    },
    "float": {
      "$value": {
        "surface": "{role.raised}",
        "border": "{role.border-strong}",
        "shadow": "0 16px 40px 0 rgba(0,0,0,0.55)"
      },
      "$description": "Menus, popovers, the HUD drawer. MyGo: Shadow(0,16,40,0,RGBA(0,0,0,.55))"
    },
    "hud": {
      "$value": {
        "surface": "rgba(14,15,18,0.82)",
        "blur": "16px",
        "border": "rgba(242,239,234,0.10)"
      },
      "$description": "Over live video. If backdrop blur costs frame time in MyGo, drop blur and raise alpha to 0.92."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "90ms",
        "$description": "Press, toggle, hover"
      },
      "base": {
        "$value": "160ms",
        "$description": "Panels, HUD drawer in"
      },
      "exit": {
        "$value": "110ms",
        "$description": "Anything leaving"
      },
      "stagger": {
        "$value": "18ms",
        "$description": "Slice-in: one step per slice"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      },
      "inout": {
        "$value": [
          0.65,
          0,
          0.35,
          1
        ]
      }
    },
    "$description": "Motion follows an input or a state change, never a scroll. Signature: slice-in (a panel appears as 4 horizontal bands, 18 ms apart, opacity + 4 px x-shift). Reduced motion: instant."
  },
  "icon": {
    "$description": "16 px grid, 1.5 px stroke, square caps, mitre joins, no fills except status glyphs. Stroke width matches the UI face at 13 px medium.",
    "grid": {
      "$type": "dimension",
      "$value": "16px"
    },
    "stroke": {
      "$type": "dimension",
      "$value": "1.5px"
    }
  }
