  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Archivo",
          "Archivo Expanded",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Archivo at width 125, weight 600. Headings, wordmark, big numerals on the site. MyGo: fonts/static/Archivo-ExpandedSemiBold.ttf. SIL OFL 1.1."
      },
      "ui": {
        "$value": [
          "Archivo",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Archivo at width 100, weights 400/500/600. Every label and control. MyGo: Archivo-Regular/Medium/SemiBold.ttf. SIL OFL 1.1."
      },
      "mono": {
        "$value": [
          "Martian Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Martian Mono at width 87.5. Telemetry, ms/fps/Mbps, codes, PINs. Monospaced so live digits never jitter. MyGo: MartianMono-SemiCondensed(.Medium).ttf. SIL OFL 1.1."
      }
    },
    "stretch": {
      "$type": "number",
      "display": {
        "$value": 125
