{
  "$description": "Planck design tokens v0.1. One source for the MyGo client (internal/ui/theme) and planck.gg (tokens.css). Format: Design Tokens Community Group draft ($value, $type, aliases as {group.token}). Generated outputs: mockups/tokens.css, export/theme_tokens.go.",
  "color": {
    "carbon": {
      "$type": "color",
      "$description": "Instrument black. Neutral, a hair cool, never navy: the ground every surface sits on.",
      "950": {
        "$value": "#07080A",
        "$description": "Stream letterbox, deepest well"
      },
      "900": {
        "$value": "#0E0F12",
        "$description": "Window ground"
      },
      "850": {
        "$value": "#14161A",
        "$description": "Panel, sidebar"
      },
      "800": {
        "$value": "#1B1D22",
        "$description": "Raised row, input fill"
      },
      "750": {
        "$value": "#22252B",
        "$description": "Hover on raised"
      },
      "700": {
        "$value": "#2C3038",
        "$description": "Border, default"
      },
      "600": {
        "$value": "#3A3F49",
        "$description": "Border, strong / control outline"
      },
      "500": {
        "$value": "#5A606C",
        "$description": "Disabled glyph"
      },
      "400": {
        "$value": "#6E7480",
        "$description": "Control edge: toggle tracks, checkboxes, input outlines (3:1 on every surface)"
      }
    },
    "bone": {
      "$type": "color",
      "$description": "Text greys, warm by a few degrees so white text reads like a lit dial, not a screen default.",
      "50": {
        "$value": "#F2EFEA",
        "$description": "Primary text, the mark"
      },
      "300": {
        "$value": "#B6B8BE",
        "$description": "Secondary text"
      },
      "400": {
        "$value": "#8C919B",
        "$description": "Tertiary text, units"
      },
      "light-ground": {
        "$value": "#F6F5F2",
        "$description": "Light theme ground"
      },
      "light-surface": {
        "$value": "#FFFFFF",
        "$description": "Light theme surface"
      },
      "light-border": {
        "$value": "#DAD8D3",
        "$description": "Light theme border"
      },
      "light-text": {
        "$value": "#0E0F12",
        "$description": "Light theme text"
      },
      "light-text-2": {
        "$value": "#4E535C",
        "$description": "Light theme secondary text"
      }
    },
    "ember": {
      "$type": "color",
      "$description": "The signature accent: about 1900 K on the Planckian (blackbody) locus. One per view: the primary action, the live latency figure, the slice in flight.",
      "300": {
        "$value": "#FFB27A"
      },
      "400": {
        "$value": "#FF9447",
        "$description": "Hover"
      },
      "500": {
        "$value": "#FF7A1F",
        "$description": "Accent"
      },
      "600": {
        "$value": "#E8650C",
        "$description": "Pressed"
      },
      "700": {
        "$value": "#A84603",
        "$description": "Accent text on light theme"
      },
      "ink": {
        "$value": "#1A0B02",
        "$description": "Text on ember fills"
      }
    },
    "signal": {
      "$type": "color",
      "$description": "Connection and health states. Never colour alone: every state carries a glyph and a label.",
      "direct": {
        "$value": "#4CD69B",
        "$description": "Direct path (LAN or Tailscale WireGuard), healthy"
      },
      "relay": {
        "$value": "#F2C94C",
        "$description": "DERP relay or degraded path"
      },
      "fault": {
        "$value": "#FF5A5A",
        "$description": "Lost, failed, dropped frames"
      },
      "direct-light": {
        "$value": "#13804F"
      },
      "relay-light": {
        "$value": "#8A6400"
      },
      "fault-light": {
        "$value": "#C42B2B"
      }
    },
    "spectrum": {
      "$type": "color",
      "$description": "Blackbody colours (approximate sRGB, from the published blackbody colour tables). Used only to colour pipeline stages in order, hottest first. Not status colours.",
      "k2000": {
        "$value": "#FF8912",
        "$description": "Capture"
      },
      "k3000": {
        "$value": "#FFB46B",
        "$description": "Encode"
      },
      "k4000": {
        "$value": "#FFD1A3",
        "$description": "Network"
      },
      "k6500": {
        "$value": "#FFF9FD",
        "$description": "Decode"
      },
      "k10000": {
        "$value": "#C9D9FF",
        "$description": "Present"
      }
    }
  },
